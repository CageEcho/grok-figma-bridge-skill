# Local settings template. setup.mjs writes the real file to your config directory
# with mode 0600 and generates the token there. Do not commit a real token.
GROK_FIGMA_BRIDGE_TOKEN=<GENERATED_BY_SETUP_NOT_COMMITTED>
GROK_FIGMA_BRIDGE_PORT=3847
GROK_FIGMA_BRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],YOUR_DEVICE.YOUR_TAILNET.ts.net
GROK_FIGMA_BRIDGE_UPSTREAM_ENTRY=/PATH/TO/figma-unified-mcp/dist/server.js
GROK_FIGMA_BRIDGE_EXPECT_WS=1
